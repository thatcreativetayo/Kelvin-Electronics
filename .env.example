# ---------------------------------------------------------------------------
# Cloud environment
# Copy to .env.local for development. Never commit the real file.
# The storefront runs without any of these: it falls back to the local seed
# catalogue and checkout stays closed. Each integration switches on only when
# all of its variables are present.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata and share images. Replace with the final
# Cloud domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact and social ------------------------------------------------------
# Digits only, including country code, no plus sign. Leave blank to route
# WhatsApp buttons to /how-it-works#contact until a real support number exists.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional overrides for the handles in src/data/site.ts. Uncomment with a full
# URL when the real accounts are ready.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle
# NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@your-handle

# --- Sanity (content) -------------------------------------------------------
# Create a project at https://sanity.io/manage, then add a CORS origin for
# http://localhost:3000 and your production domain.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Read token is only needed for private datasets. Published content is readable
# with the project ID + dataset alone.
SANITY_API_READ_TOKEN=
# Where the footer studio link points. Leave as /studio for the local
# integration-status board, or use a deployed Studio URL.
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# --- Supabase (commerce) ----------------------------------------------------
# Project settings → API. The service-role key must never be exposed to the
# browser or prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (media) -----------------------------------------------------
# Used by the signed-upload endpoint and by the Studio image input.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=cloud/products
# Shared secret the Studio sends to /api/cloudinary/sign. Generate a long
# random value. Rotate it if a Studio operator leaves.
CLOUDINARY_UPLOAD_TOKEN=

# --- Payments (checkout boundary) -------------------------------------------
# Checkout remains closed until this exists, alongside Supabase. The provider
# adapter is intentionally not implemented in this build: no fake payments.
PAYMENT_PROVIDER_SECRET_KEY=
