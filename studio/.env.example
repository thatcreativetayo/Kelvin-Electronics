# Sanity Studio environment
# Copy to studio/.env.local. Only SANITY_STUDIO_* variables are bundled into the
# Studio, so never put API secrets here.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Optional: the hostname used by `sanity deploy` (cloud.sanity.studio).
SANITY_STUDIO_HOST=
# Used only to render Cloudinary thumbnails inside the Studio.
SANITY_STUDIO_CLOUDINARY_CLOUD_NAME=
